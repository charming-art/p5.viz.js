{
  "name": "p5.viz",
  "version": "0.0.1",
  "description": "A data storytelling library for p5.js.",
  "author": "Bairui Su",
  "license": "ISC",
  "homepage": "https://github.com/charming-art/p5.viz.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charming-art/p5.viz.js.git"
  },
  "keywords": [
    "p5",
    "p5.js",
    "visualization",
    "chart",
    "data",
    "dataviz"
  ],
  "main": "dist/p5.viz.js",
  "module": "dist/p5.viz.mjs",
  "exports": {
    ".": {
      "import": "./dist/p5.viz.mjs",
      "default": "./dist/p5.viz.js"
    }
  },
  "unpkg": "dist/p5.viz.min.js",
  "jsdelivr": "dist/p5.viz.min.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && rollup -c",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "p5": "^2.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "p5": "^2.0.3",
    "rollup": "^4.64.7",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2"
  }
}
